# The whole drawing-review flow by clicks, one screenshot per step (scripts/render-perf/README.md,
# "Review workflow scenes"). The one canonical full flow:
#   npx tsx scripts/ui-look/look.ts --dist .ui-look/<you> --theme dark --out <dir> --steps scripts/ui-look/flows/review-full.steps
# Package -> submit -> Sam marks up (comments, a reply) and requests changes, Alex approves -> the
# author sees what to fix, resolves comments (Sam's too, schema 512), checks in a new version and
# resubmits -> round 2 (earlier comments shown, the carried-forward files not decidable) ->
# approvals with Undo -> approved -> moved to Released.
# Selectors are the English labels of the review UI (decision buttons by data-decision); file
# names show with lowercase extensions (the default display preference), and text= is
# case-insensitive. Each decision waits 5 s for its Undo window before the next person acts.
# Verified 2026-11-04 against the redesigned review UI (5.9.x).

# 1. The author builds a package from a selection and sends it to Sam and Alex.
--scene review-flow-start
--wait 600
--shot 01-start
--click text=PMP-2000.slddrw
--ctrlclick text=PMP-2000.sldasm
--ctrlclick text=PMP-2003.slddrw
--rclick text=PMP-2003.slddrw
--hover .context-menu-item:has-text('Reviews') >> nth=0
--wait 400
--shot 02-menu
--click .context-menu-item:has-text('Start a review') >> nth=-1
--wait 1200
--shot 03-package
# Generate PDFs needs SOLIDWORKS, which the boot does not have: record the seal drawing's PDF instead.
--eval __blueplmLook.review.reviews.renderPdf('PMP-2003.SLDDRW')
--fill #review-draft-title=Pump assembly, rev B release
--fill #review-draft-message=Full drawing package for the rev B build. Check the BOM and the seal callout.
--fill input[placeholder='Search people or teams']=sam
--wait 300
--click [role=option]:has-text('Sam Rivera')
--fill input[placeholder='Search people or teams']=alex
--wait 300
--click [role=option]:has-text('Alex Kim')
--wait 500
--shot 04-reviewers
--click button:has-text('Request review')
--wait 1200
--shot 05-sent

# 2. Sam: the notification, the queue, two markups and a reply, changes requested on the drawing.
--as sam
--wait 1500
--shot 06-sam-notified
--eval __blueplmLook.store.getState().setActiveView('reviews')
--wait 800
--click text=Waiting on me
--wait 800
--shot 07-sam-queue
--click text="Pump assembly, rev B release"
--wait 2500
--shot 08-sam-detail
--click text=PMP-2000.slddrw >> nth=0
--wait 2500
--shot 09-sam-drawing
--drag 700,250,770,300
--wait 600
--fill textarea[aria-label='Comment text']=The BOM table is missing the seal part PMP-2003.
--press Enter
--wait 900
--drag 900,380,990,440
--wait 600
--fill textarea[aria-label='Comment text']=Balloon 4 points at the wrong item.
--press Enter
--wait 900
--click [aria-label='Reply to comment'] >> nth=0
--fill textarea[placeholder='Write a reply…']=Also the revision table still says rev A.
--press Enter
--wait 900
--shot 10-sam-markup
--click button[data-decision=changes_requested]
--wait 300
--fill #decision-comment=BOM and balloons need fixing; see the two markups.
--shot 11-sam-changes-prompt
--press Control+Enter
--wait 800
--click button:has-text('Approve remaining')
--wait 300
--press Control+Enter
--wait 1200
--shot 12-sam-undo-window
--wait 5500
--shot 13-sam-done

# 3. Alex approves everything (all mode: the review settles as changes requested).
--as alex
--wait 1500
--click text=Waiting on me
--wait 800
--click text="Pump assembly, rev B release"
--wait 2500
--shot 14-alex-detail
--click button:has-text('Approve remaining')
--wait 300
--press Control+Enter
--wait 5800
--shot 15-alex-done

# 4. The author: what to fix, resolves a reviewer's comment, checks in v5 and resubmits.
--as author
--wait 1500
--click text=My requests
--wait 800
--click text="Pump assembly, rev B release"
--wait 2500
--shot 16-author-kickback
--click [aria-label='Resolve comment'] >> nth=0
--wait 1000
--shot 17-author-resolved
--eval __blueplmLook.review.checkIn('PMP-2000.SLDDRW')
--wait 1500
--shot 18-author-checked-in
--click button:has-text('Resubmit')
--wait 1500
--fill [role=dialog] textarea=Added the seal to the BOM, fixed balloon 4 and the revision table.
--shot 19-resubmit-dialog
--click [role=dialog] button:has-text('Resubmit')
--wait 2500
--shot 20-round2-author

# 5. Round 2: Sam sees round 1's comments, the carried-forward files, approves with Undo.
--as sam
--wait 1500
--click text=Waiting on me
--wait 800
--click text="Pump assembly, rev B release"
--wait 2500
--shot 21-sam-round2
--click text=PMP-2000.sldasm >> nth=0
--wait 1500
--shot 22-sam-round2-carried
--click text=PMP-2000.slddrw >> nth=0
--wait 2000
--click button[data-decision=approved]
--wait 1200
--shot 23-sam-approve-undo
--click button:has-text('Undo')
--wait 800
--shot 24-sam-undone
--click button[data-decision=approved]
--wait 5800
--shot 25-sam-round2-done
--as alex
--wait 1500
--click text=Waiting on me
--wait 800
--click text="Pump assembly, rev B release"
--wait 2500
--click button[data-decision=approved]
--wait 5800
--shot 26-alex-round2-done

# 6. The author: approved, held in the review stage, moved to Released.
--as author
--wait 1500
--click text=Done
--wait 800
--click text="Pump assembly, rev B release"
--wait 2500
--shot 27-approved
--click button:has-text('Move package')
--wait 2500
--shot 28-released
